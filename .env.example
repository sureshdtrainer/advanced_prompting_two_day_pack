# Copy to .env and populate locally. Never commit .env.

# Choose which provider to use in labs/03_sequential_workflow_model.py
# Values: openai | google
LLM_PROVIDER=openai

# Optional: network timeout (seconds) for live API calls
LLM_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google AI Studio / Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=advanced-prompting-training
